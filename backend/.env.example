# Copy to backend/.env. Never commit .env.
APP_ENV=development
# Must match the credentials in the root .env (docker compose).
DATABASE_URL=postgresql+psycopg://vko:change_me@localhost:5432/vko_archive
# Separate database used by pytest (created automatically on the same server).
TEST_DATABASE_URL=postgresql+psycopg://vko:change_me@localhost:5432/vko_archive_test
CORS_ORIGINS=["http://localhost:3000"]
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
# OCR fallback without Tesseract: a vision model pulled in Ollama (empty = none)
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=5
OLLAMA_CHAT_TIMEOUT_SECONDS=120
OLLAMA_PARSER_TIMEOUT_SECONDS=60
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=400
AI_MAX_CONCURRENT_GENERATIONS=2
AI_RATE_LIMIT_PER_MINUTE=10
OLLAMA_EMBED_TIMEOUT_SECONDS=30
HEALTH_PROBE_TIMEOUT_SECONDS=3
HEALTH_CACHE_TTL_SECONDS=60
# Signing key for admin session tokens, at least 32 random characters. `make env` generates it;
# manually: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=change_me_jwt_secret
# The session cookie is Secure (browsers accept it on https and http://localhost).
SESSION_COOKIE_SECURE=true
# Public site origin: the base of links in e-mails (password reset, e-mail confirmation).
FRONTEND_URL=http://localhost:3000
# Outgoing mail over SMTP with STARTTLS. Empty SMTP_HOST = mail is not sent (nothing fails).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# «Sign in with Google» (cabinet). Create an OAuth Web client in Google Cloud Console; empty = no button.
GOOGLE_CLIENT_ID=
