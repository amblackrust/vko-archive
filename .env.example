# Docker Compose settings. `make env` copies this to .env and generates the secrets. Never commit .env.
POSTGRES_USER=vko
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vko_archive
POSTGRES_PORT=5432

# Signing key of the session tokens, at least 32 random characters: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=change_me_jwt_secret

# Password of the demo staff accounts (superadmin@demo.kz, editor@demo.kz, ...). Empty = no demo accounts are created.
DEMO_PASSWORD=change_me_demo_password

# Models pulled into Ollama on the first `docker compose up`.
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3

# Browsers accept Secure cookies on http://localhost; set false when the site is opened by an IP address over http.
SESSION_COOKIE_SECURE=true

# «Sign in with Google» in the visitor cabinet (OAuth Web client id). Empty = no button.
GOOGLE_CLIENT_ID=
